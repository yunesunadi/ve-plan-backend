{
  "name": "ve-plan-backend",
  "version": "1.0.0",
  "description": "A comprehensive virtual event planning platform for organizing and attending virtual events",
  "main": "dist/index.js",
  "scripts": {
    "start": "npx tsc && nodemon dist/index.js",
    "dev": "concurrently \"npx tsc --watch\" \"nodemon dist/index.js\"",
    "build": "npx tsc && cp -r src/email_templates dist/email_templates",
    "migrate": "npm run build && node dist/migrations/cli.js",
    "migrate:status": "npm run build && node dist/migrations/cli.js status",
    "pm2:start": "npm run build && pm2 start ecosystem.config.js",
    "pm2:restart": "npm run build && pm2 restart ecosystem.config.js",
    "pm2:stop": "pm2 stop ecosystem.config.js",
    "pm2:logs": "pm2 logs ve-plan-backend"
  },
  "author": "Yune Su Nadi",
  "license": "ISC",
  "dependencies": {
    "@types/socket.io": "^3.0.1",
    "bcrypt": "^5.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "jwt-decode": "^4.0.0",
    "luxon": "^3.7.2",
    "mongoose": "^8.9.1",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^6.10.1",
    "passport": "^0.7.0",
    "passport-facebook": "^3.0.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/luxon": "^3.7.5",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.17",
    "@types/passport": "^1.0.17",
    "@types/passport-facebook": "^3.0.3",
    "@types/passport-google-oauth20": "^2.0.16",
    "@types/passport-jwt": "^4.0.1",
    "concurrently": "^9.1.0",
    "nodemon": "^3.1.9",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": "^22.x"
  },
  "allowScripts": {
    "bcrypt@5.1.1": true
  }
}
